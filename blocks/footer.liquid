{% doc %}
  Renders the dark storefront footer: stacked logo, showroom address,
  opening hours and contact details from the Cool Fox Tees theme settings.
  Composed directly in layout/theme.liquid so it appears on every page.
{% enddoc %}

{%- assign email = settings.email | default: shop.email -%}

<footer class="foot full-width" id="visit" {{ block.shopify_attributes }}>
  <div class="in">
    <a href="{{ routes.root_url }}">
      {{- 'logo-stacked.svg' | asset_url | image_tag: width: 120, height: 103, alt: shop.name, loading: 'lazy' -}}
    </a>
    <div>
      <h3>{{ 'footer.visit_us' | t }}</h3>
      <p>{{ settings.showroom_address }}</p>
    </div>
    <div>
      <h3>{{ 'footer.opening_hours' | t }}</h3>
      <p>{{ settings.showroom_hours }}.<br>{{ 'footer.call_first' | t }}</p>
    </div>
    <div>
      <h3>{{ 'footer.get_in_touch' | t }}</h3>
      {%- if settings.phone != blank -%}
        <p><a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a></p>
      {%- endif -%}
      {%- if email != blank -%}
        <p><a href="mailto:{{ email }}">{{ email }}</a></p>
      {%- endif -%}
    </div>
  </div>
  <div class="in foot-base">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": []
}
{% endschema %}
