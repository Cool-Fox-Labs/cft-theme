{% doc %}
  Renders the storefront header: the showroom info bar, the dark menu strip
  with the wordmark, the Garments, Services and Help drop-down panels, and the
  phone menu drawer. Composed directly in layout/theme.liquid so it wraps
  every page. Business details come from the Cool Fox Tees theme settings.
{% enddoc %}
{%- comment -%}
  Basket link wording (Eddie, 22/11/2026): "Your quote" while the basket holds
  only quote items; "Basket" once it holds any Buy now items (quick tees).
{%- endcomment -%}
{%- liquid
  assign basket_label = 'header.basket' | t
  for item in cart.items
    if item.final_price > 0 and item.product.tags contains 'buy-online' or item.product.handle == 'back-print'
      assign basket_label = 'header.basket_buy' | t
      break
    endif
  endfor
-%}

{%- assign how_url = routes.root_url | append: '#how' -%}
{%- comment -%} Sign-in lands on the Print Studio dashboard (/apps/account). {%- endcomment -%}
{%- assign login_base = routes.storefront_login_url | split: '?' | first -%}
{%- assign login_url = login_base | append: '?return_to=%2Fapps%2Faccount' -%}
{%- comment -%} "Get a quote" (Eddie 21/11, was "Build your quote") starts at All garments. The Get a quote page holds only the "tell us what you need" form, linked from the bottom of All garments. {%- endcomment -%}
{%- assign quote_url = routes.collections_url -%}
{%- assign showroom_url = routes.root_url | append: '#showroom' -%}
{%- assign contact_page = pages['contact'] -%}

<header class="site-head full-width" id="site-head" {{ block.shopify_attributes }}>
  <div class="infobar">
    <div class="in">
      <span>
        <span class="dot-s" aria-hidden="true"></span>
        <b>{{ 'header.showroom_open' | t }}</b>
        {{ settings.showroom_hours }}
        <span class="hide-s"> &middot; {{ settings.showroom_address }}</span>
      </span>
      {%- if settings.google_rating != blank -%}
        <span>
          <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          {{ 'header.google_rating_html' | t: rating: settings.google_rating, count: settings.google_review_count }}
        </span>
      {%- endif -%}
    </div>
  </div>

  <div class="strip">
    <div class="in">
      <a href="{{ routes.root_url }}" class="logo-link">
        <img class="logo" src="{{ 'logo-wordmark.svg' | asset_url }}" width="140" height="56" alt="{{ shop.name | escape }}">
      </a>

      <nav class="nav" aria-label="{{ 'header.main_menu' | t }}">
        <button class="top" type="button" aria-expanded="false" aria-controls="panel-garments">
          {{ 'header.garments' | t }}
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        {%- if settings.show_services_menu -%}
        <button class="top" type="button" aria-expanded="false" aria-controls="panel-services">
          {{ 'header.services' | t }}
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        {%- endif -%}
        <button class="top" type="button" aria-expanded="false" aria-controls="panel-help">
          {{ 'header.help' | t }}
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <a href="{{ showroom_url }}"><span class="dot" aria-hidden="true"></span>{{ 'header.visit_showroom' | t }}</a>
        {%- if contact_page != empty and contact_page != nil -%}<a href="{{ contact_page.url }}">{{ 'header.contact' | t }}</a>{%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          {%- if customer -%}
            <a class="basket-link acc-link" href="/apps/account"><svg class="hd-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 21c1.2-4.2 4.3-6.2 8-6.2s6.8 2 8 6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="hd-txt">{{ 'header.account' | t }}</span></a>
          {%- else -%}
            <a class="basket-link acc-link" href="{{ login_url }}"><svg class="hd-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 21c1.2-4.2 4.3-6.2 8-6.2s6.8 2 8 6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="hd-txt">{{ 'header.log_in' | t }}</span></a>
          {%- endif -%}
        {%- endif -%}
        <a class="basket-link q-link" href="{{ routes.cart_url }}" data-basket-link data-cart-js="{{ routes.cart_url }}.js" data-count="{{ cart.item_count }}"{% if cart.item_count == 0 %} hidden{% endif %}><svg class="hd-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 4.5V3h6v1.5M8.5 10h7M8.5 14h7M8.5 18h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="hd-txt"><span data-basket-label data-quote="{{ 'header.basket' | t | escape }}" data-buy="{{ 'header.basket_buy' | t | escape }}">{{ basket_label }}</span> (</span><span class="q-count" data-basket-count>{{ cart.item_count }}</span><span class="hd-txt">)</span></a>
        <a class="pill pill-o" href="{{ quote_url }}">{{ 'header.get_quote' | t }}</a>
        <button class="burger" type="button" id="menu-btn" aria-expanded="false" aria-controls="drawer" data-open-label="{{ 'header.close' | t }}" data-closed-label="{{ 'header.menu' | t }}">
          {{- 'header.menu' | t -}}
        </button>
      </nav>
    </div>
  </div>

  <div class="panel" id="panel-garments" hidden>
    <div class="panel-in panel-mega">
      <h3>{{ 'header.choose_garment' | t }}</h3>
      {%- comment -%} The photo menu ('menu-mega') is fetched once by theme.js on wide screens; the plain list shows until then. {%- endcomment -%}
      <div data-mega data-mega-url="{{ routes.collections_url }}?view=mega">{% render 'menu-links', list: 'garments' %}</div>
    </div>
  </div>

  {%- if settings.show_services_menu -%}
  <div class="panel" id="panel-services" hidden>
    <div class="panel-in">
      <div>
        <h3>{{ 'header.what_we_print_for' | t }}</h3>
        {% render 'menu-links', list: 'services' %}
      </div>
      <a class="promo promo-d" href="{{ routes.root_url }}#bulk">
        <span class="big-num">20%</span>
        <b>{{ 'header.promo_bulk_title' | t }}</b>
        <span>{{ 'header.promo_bulk_text' | t }}</span>
      </a>
      <a class="promo promo-o" href="{{ how_url }}">
        <b>{{ 'header.promo_no_minimum_title' | t }}</b>
        <span>{{ 'header.promo_no_minimum_text' | t }}</span>
      </a>
    </div>
  </div>
  {%- endif -%}

  <div class="panel" id="panel-help" hidden>
    <div class="panel-in panel-help">
      <div>
        <h3>{{ 'header.help_title' | t }}</h3>
        {% render 'help-links', style: 'cats' %}
      </div>
    </div>
  </div>

  <div class="drawer" id="drawer" hidden>
    <div class="in">
      <details>
        <summary>{{ 'header.garments' | t }}</summary>
        {% render 'menu-links', list: 'garments' %}
      </details>
      {%- if settings.show_services_menu -%}
      <details>
        <summary>{{ 'header.services' | t }}</summary>
        {% render 'menu-links', list: 'services' %}
      </details>
      {%- endif -%}
      <details>
        <summary>{{ 'header.help' | t }}</summary>
        {% render 'help-links', style: 'cats' %}
      </details>
      <a href="{{ showroom_url }}">{{ 'header.visit_showroom' | t }}</a>
      {%- if contact_page != empty and contact_page != nil -%}<a href="{{ contact_page.url }}">{{ 'header.contact' | t }}</a>{%- endif -%}
      <a href="{{ routes.cart_url }}"><span data-basket-label data-quote="{{ 'header.basket' | t | escape }}" data-buy="{{ 'header.basket_buy' | t | escape }}">{{ basket_label }}</span> (<span data-basket-count>{{ cart.item_count }}</span>)</a>
      {%- if shop.customer_accounts_enabled -%}
        {%- if customer -%}
          <a href="/apps/account">{{ 'header.account' | t }}</a>
          <a href="{{ routes.account_logout_url }}">{{ 'header.log_out' | t }}</a>
        {%- else -%}
          <a href="{{ login_url }}">{{ 'header.log_in' | t }}</a>
        {%- endif -%}
      {%- endif -%}
      <a class="pill pill-o" href="{{ quote_url }}">{{ 'header.get_quote' | t }}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": []
}
{% endschema %}
