{% doc %}
  Renders the product page: a photo stage, colour, a size grid with the bulk
  discount nudge, a "Your design" card and one button. The button reads
  "Add to quote" on quote-only products and "Add to order" on priced ones;
  both put the sizes in the basket with the design as line item properties.

  The design is added in one of two pop-ups:
  - Design it yourself: Front / Back / sleeve buttons on the canvas. Add a
    logo or text, drag it to move it, drag its corner to resize it, inside
    the dashed print area. Sleeves zoom into the front photo.
  - Just send us your files: upload files, tick positions for each, and pick
    the same size choices.
  Both say we check artwork, size and position before printing.

  Product data it reads:
  - Variant images are the flat colour shots. Supplier lifestyle shots
    (file names containing _LS00_) are never shown, per the imagery terms.
  - A price of 0 or the tag "quote-only" makes it a quote item, because
    Shopify stores a blank price as 0.00.
  - Metafield cft.size_guide (rich text) fills the size guide. No metafield,
    no size guide link.
  - Metafield cft.print_positions (JSON) can change the print areas, e.g. a
    smaller front for women's and kids' garments:
    {"inch": 2.4, "areas": {"front": {"w": 9, "h": 12, "x": 50, "y": 25}}}.
    x is the centre and y the top, as % of the photo; w and h are inches;
    inch is how much of the photo width one inch covers. "positions" (the
    send-your-files choices) can still be replaced as before.

  @example
  {% block 'product-builder' %}{% endblock %}
{% enddoc %}

{%- liquid
  assign colour_i = 0
  assign size_i = 1
  for option in product.options_with_values
    assign n = option.name | downcase
    if n == 'colour' or n == 'color'
      assign colour_i = forloop.index0
    elsif n == 'size'
      assign size_i = forloop.index0
    endif
  endfor

  assign fallback_image = null
  for image in product.images
    assign src = image.src | downcase
    unless src contains '_ls00_'
      assign fallback_image = image
      break
    endunless
  endfor

  assign quote_only = false
  if product.price == 0 or product.tags contains 'quote-only'
    assign quote_only = true
  endif

  assign size_guide = product.metafields.cft.size_guide
-%}

<div class="pdp-wrap" {{ block.shopify_attributes }}>
  <nav class="crumbs" aria-label="{{ 'product.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'product.home' | t }}</a> /
    {% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a> /{% endif %}
    {{ product.title | escape }}
  </nav>

  <div class="pdp" id="pdp">
    <div class="gallery">
      <div class="stage-p" data-stage="page">
        <div class="view-tabs" role="group" aria-label="{{ 'product.view' | t }}">
          <button type="button" data-view="front" aria-pressed="true">{{ 'product.front' | t }}</button>
          <button type="button" data-view="back" aria-pressed="false">{{ 'product.back' | t }}</button>
        </div>
        <p class="back-note" data-back-note hidden>{{ 'product.back_note' | t }}</p>
        <div class="zoom" data-zoom>
          {%- if fallback_image -%}
            {{ fallback_image | image_url: width: 1000 | image_tag: class: 'shirt', data-shirt: '', alt: product.title, sizes: '(min-width: 900px) 50vw, 100vw' }}
          {%- else -%}
            <img class="shirt" data-shirt src="{{ 'logo-fox-head.svg' | asset_url }}" width="500" height="600" alt="">
          {%- endif -%}
          <div data-placements></div>
        </div>
        <p class="ref-note">{{ 'product.ref_note' | t }}</p>
      </div>
    </div>

    <div class="info">
      <div class="ttl">
        <span class="eyebrow eyebrow-muted">{{ product.vendor | escape }} · {{ product.handle | upcase }}</span>
        <h1>{{ product.title | escape }}</h1>
      </div>

      <div class="price-row">
        {%- if quote_only -%}
          <b>{{ 'product.price_on_quote' | t }}</b>
        {%- else -%}
          {%- assign price_min = product.price_min | money -%}
          <span class="price-from">{{ 'product.price_from_html' | t: price: price_min }}</span>
        {%- endif -%}
        <span>{{ 'product.bulk_line' | t }}</span>
      </div>

      <section class="step" aria-labelledby="s-colour">
        <div class="step-h"><i>1</i><h2 id="s-colour">{{ 'product.step_colour' | t }}</h2><small data-colour-name></small></div>
        <div class="swatches" data-swatches></div>
        <span class="sw-key" data-sw-key hidden></span>
      </section>

      <section class="step" aria-labelledby="s-sizes">
        <div class="step-h"><i>2</i><h2 id="s-sizes">{{ 'product.step_sizes' | t }}</h2><small data-total></small></div>
        <div class="sizes" data-sizes></div>
        <div class="size-links">
          {%- if size_guide != blank -%}
            <button type="button" class="text-btn" data-size-open>{{ 'product.size_guide' | t }}</button>
          {%- endif -%}
          <span data-size-note></span>
        </div>
        <div class="nudge"><b data-nudge-pct>0%</b><div class="bar"><span data-nudge-bar></span></div><span data-nudge-text></span></div>
      </section>

      <section class="step" aria-labelledby="s-design">
        <div class="step-h"><i>3</i><h2 id="s-design">{{ 'product.step_design' | t }}</h2></div>
        <div class="design-card" data-design-empty>
          <button type="button" class="route" data-open="designer">
            <b>{{ 'product.route_designer' | t }}</b><span>{{ 'product.route_designer_text' | t }}</span>
          </button>
          <button type="button" class="route" data-open="files">
            <b>{{ 'product.route_files' | t }}</b><span>{{ 'product.route_files_text' | t }}</span>
          </button>
        </div>
        <div class="design-card design-set" data-design-set hidden>
          <ul class="chosen" data-design-summary></ul>
          <div class="design-actions">
            <button type="button" class="text-btn" data-edit>{{ 'product.edit_design' | t }}</button>
            <button type="button" class="text-btn" data-clear>{{ 'product.remove_design' | t }}</button>
          </div>
        </div>
      </section>

      <div class="cta-box">
        <div class="cta-sum"><span>{{ 'product.your_selection' | t }}</span><b data-sum></b></div>
        <button type="button" class="pill pill-o" data-add>
          {%- if quote_only -%}{{ 'product.add_to_quote' | t }}{%- else -%}{{ 'product.add_to_order' | t }}{%- endif -%}
        </button>
        <p data-add-msg aria-live="polite">{{ 'product.add_note' | t }}</p>
      </div>

      <div class="trust">
        <div><b>{{ 'product.trust_proof_title' | t }}</b>{{ 'product.trust_proof' | t }}</div>
        <div><b>{{ 'product.trust_time_title' | t }}</b>{{ 'product.trust_time' | t }}</div>
        <div><b>{{ 'product.trust_showroom_title' | t }}</b>{{ settings.showroom_address | escape }}</div>
      </div>
    </div>
  </div>

  <div class="more">
    <section class="panel-c" aria-labelledby="d-h">
      <h2 id="d-h">{{ 'product.details' | t }}</h2>
      <div class="rte">{{ product.description }}</div>
    </section>
    <section class="panel-c" aria-labelledby="p-h">
      <h2 id="p-h">{{ 'product.positions' | t }}</h2>
      <p>{{ 'product.positions_intro' | t }}</p>
      <div class="table-scroll">
        <table class="pos-table">
          <thead><tr><th>{{ 'product.position' | t }}</th><th>{{ 'product.print_width' | t }}</th></tr></thead>
          <tbody data-pos-table></tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="mob-bar"><span data-mob-sum></span><button type="button" class="pill pill-o" data-add>
    {%- if quote_only -%}{{ 'product.add_to_quote' | t }}{%- else -%}{{ 'product.add_to_order' | t }}{%- endif -%}
  </button></div>

  <dialog class="dz" data-designer aria-labelledby="dz-h">
    <div class="dz-bar">
      <h2 id="dz-h">{{ 'product.route_designer' | t }}</h2>
      <button type="button" class="pill pill-o" data-dz-save>{{ 'product.save' | t }}</button>
      <button type="button" class="art-x" data-dz-close aria-label="{{ 'product.close' | t }}">&times;</button>
    </div>
    <div class="dz-body">
      <div class="dz-left">
      <div class="stage-p" data-stage="designer">
        <div class="view-tabs dz-views" role="group" aria-label="{{ 'product.view' | t }}" data-dz-views></div>
        <p class="back-note" data-back-note hidden>{{ 'product.back_note' | t }}</p>
        <div class="zoom" data-zoom>
          <img class="shirt" data-shirt src="{{ 'logo-fox-head.svg' | asset_url }}" width="500" height="600" alt="">
          <div data-placements></div>
        </div>
        <p class="ref-note">{{ 'product.ref_note' | t }}</p>
      </div>
      <div class="dz-add" data-dz-add></div>
      </div>
      <div class="dz-side">
        <div class="dz-panel" data-dz-panel></div>
        <p class="check-note">{{ 'product.check_note' | t }}</p>
      </div>
    </div>
  </dialog>

  <dialog class="dz fz" data-files aria-labelledby="fz-h">
    <div class="dz-bar">
      <h2 id="fz-h">{{ 'product.route_files' | t }}</h2>
      <button type="button" class="pill pill-o" data-fz-save>{{ 'product.save' | t }}</button>
      <button type="button" class="art-x" data-fz-close aria-label="{{ 'product.close' | t }}">&times;</button>
    </div>
    <div class="fz-body">
      <p>{{ 'product.files_intro' | t }}</p>
      <label class="pill pill-l">{{ 'product.upload_files' | t }}<input type="file" data-fz-input multiple accept="image/*,application/pdf,.ai,.eps,.svg"></label>
      <ul class="fz-list" data-fz-list></ul>
      <label class="fz-note">{{ 'product.files_note' | t }}<textarea data-fz-note rows="3"></textarea></label>
      <p class="fz-msg" data-fz-msg aria-live="polite"></p>
      <p class="check-note">{{ 'product.check_note' | t }}</p>
    </div>
  </dialog>

  {%- if size_guide != blank -%}
    <dialog class="size-dlg" data-size-dlg aria-labelledby="sg-h">
      <div class="art-top">
        <h2 id="sg-h">{{ 'product.size_guide_title' | t }}</h2>
        <button type="button" class="art-x" data-size-close aria-label="{{ 'product.close' | t }}">&times;</button>
      </div>
      <div class="rte">{{ size_guide | metafield_tag }}</div>
    </dialog>
  {%- endif -%}
</div>

<script type="application/json" data-pdp-data>
  {
    "title": {{ product.title | json }},
    "quoteOnly": {{ quote_only | json }},
    "cartAdd": {{ routes.cart_add_url | append: '.js' | json }},
    "cartUrl": {{ routes.cart_url | json }},
    "selectedColour": {{ product.selected_or_first_available_variant.options[colour_i] | json }},
    "sizes": [
      {%- for value in product.options_with_values[size_i].values -%}
        {{ value.name | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "colours": [
      {%- for value in product.options_with_values[colour_i].values -%}
        {%- if value.swatch.color -%}{%- assign hex = value.swatch.color | json -%}{%- else -%}{%- assign hex = 'null' -%}{%- endif -%}
        {"name": {{ value.name | json }}, "hex": {{ hex }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "variants": [
      {%- for variant in product.variants -%}
        {%- assign img = variant.featured_image | default: fallback_image -%}
        {
          "id": {{ variant.id | json }},
          "colour": {{ variant.options[colour_i] | json }},
          "size": {{ variant.options[size_i] | json }},
          "img": {% if img %}{{ img | image_url: width: 1000 | json }}{% else %}null{% endif %},
          "thumb": {% if img %}{{ img | image_url: width: 160 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "print": {{ product.metafields.cft.print_positions.value | json }},
    "t": {
      "pos": {
        "fr": {{ 'product.pos_fr' | t | json }}, "fb": {{ 'product.pos_fb' | t | json }},
        "ls": {{ 'product.pos_ls' | t | json }}, "rs": {{ 'product.pos_rs' | t | json }}
      },
      "upTo": {{ 'product.up_to_size' | t: size: '%s' | json }},
      "notMade": {{ 'product.size_not_made' | t | json }},
      "inWide": {{ 'product.in_wide' | t: w: '%w' | json }},
      "wxh": {{ 'product.size_wxh' | t: w: '%w', h: '%h' | json }},
      "inches": {{ 'product.inches' | t: w: '%w' | json }},
      "itemsOne": {{ 'product.items_one' | t | json }},
      "itemsOther": {{ 'product.items_other' | t: count: '%n' | json }},
      "addMore": {{ 'product.add_more' | t: n: '%n', pct: '%p' | json }},
      "top": {{ 'product.top_discount' | t | json }},
      "front": {{ 'product.front' | t | json }},
      "addDesign": {{ 'product.add_design' | t | json }},
      "addText": {{ 'product.add_text' | t | json }},
      "replace": {{ 'product.replace' | t | json }},
      "remove": {{ 'product.remove' | t | json }},
      "emptyPos": {{ 'product.empty_position' | t | json }},
      "line1": {{ 'product.text_line1' | t | json }},
      "line2": {{ 'product.text_line2' | t | json }},
      "font": {{ 'product.text_font' | t | json }},
      "colour": {{ 'product.text_colour' | t | json }},
      "fonts": [
        ["font-display", {{ 'product.font_bold' | t | json }}],
        ["font-primary--family", {{ 'product.font_clean' | t | json }}],
        ["font-mono", {{ 'product.font_type' | t | json }}]
      ],
      "inks": [
        ["#FFFFFF", {{ 'product.ink_white' | t | json }}],
        ["#1D1D1B", {{ 'product.ink_black' | t | json }}],
        ["#EB7024", {{ 'product.ink_orange' | t | json }}],
        ["#1F2A44", {{ 'product.ink_navy' | t | json }}]
      ],
      "vector": {{ 'product.check_vector' | t | json }},
      "good": {{ 'product.check_good' | t | json }},
      "ok": {{ 'product.check_ok' | t | json }},
      "low": {{ 'product.check_low' | t | json }},
      "bestSize": {{ 'product.best_size' | t | json }},
      "specificSize": {{ 'product.specific_size' | t | json }},
      "chestLogo": {{ 'product.chest_logo' | t | json }},
      "chestTag": {{ 'product.chest_tag' | t | json }},
      "sizeLabel": {{ 'product.size_label' | t | json }},
      "areaTag": {{ 'product.area_tag' | t | json }},
      "addAnother": {{ 'product.add_another' | t | json }},
      "placement": {{ 'product.placement' | t | json }},
      "emptyView": {{ 'product.empty_view' | t | json }},
      "tapToEdit": {{ 'product.tap_to_edit' | t | json }},
      "dragHint": {{ 'product.drag_hint' | t | json }},
      "where": {{ 'product.where' | t: down: '%d', side: '%s' | json }},
      "centred": {{ 'product.centred' | t | json }},
      "rightOf": {{ 'product.right_of' | t: n: '%n' | json }},
      "leftOf": {{ 'product.left_of' | t: n: '%n' | json }},
      "widthIn": {{ 'product.width_in' | t | json }},
      "removeFile": {{ 'product.remove_file' | t | json }},
      "needPosition": {{ 'product.need_position' | t | json }},
      "designedOnline": {{ 'product.designed_online' | t | json }},
      "filesSent": {{ 'product.files_sent' | t | json }},
      "text": {{ 'product.text_design' | t | json }},
      "note": {{ 'product.note' | t | json }},
      "noDesign": {{ 'product.no_design' | t | json }},
      "needItems": {{ 'product.need_items' | t | json }},
      "adding": {{ 'product.adding' | t | json }},
      "added": {{ 'product.added_html' | t: url: '%u' | json }},
      "addFail": {{ 'product.add_fail' | t | json }},
      "artwork": {{ 'product.artwork' | t | json }},
      "printLabel": {{ 'product.print_label' | t | json }}
    }
  }
</script>
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.product_builder",
  "settings": []
}
{% endschema %}
