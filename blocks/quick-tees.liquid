{% doc %}
  Renders the homepage "Quick print tees" strip (Eddie, 21/11/2026): one slim
  line under the hero linking to the quick-tees collection page, which holds
  the same-day tees and their rules. Hidden when that collection is missing
  or empty.

  @param {string} content - Required. The strip's text.

  @example
  {% block 'quick-tees' %}
    <b>{{ 'home.quick.title' | t }}</b>
  {% endblock %}
{% enddoc %}

{%- assign quick = collections['quick-tees'] -%}
{%- if quick != blank and quick.products.size > 0 -%}
  <section class="quick-strip" aria-label="{{ 'home.quick.title' | t }}" {{ block.shopify_attributes }}>
    <a class="quick-strip-in" href="{{ quick.url }}">
      <span class="quick-strip-dot" aria-hidden="true"></span>
      <span class="quick-strip-text">{{ content }}</span>
      <span class="pill pill-d quick-strip-cta">{{ 'home.quick.cta' | t }} <span aria-hidden="true">&rarr;</span></span>
    </a>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:general.quick_tees",
  "settings": []
}
{% endschema %}
