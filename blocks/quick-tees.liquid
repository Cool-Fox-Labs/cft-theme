{% doc %}
  Renders the homepage "Quick print tees" banner (Eddie, 21/11/2026): a photo
  of the classic tees on a man, woman and child (theme asset quick-tees-family.jpg,
  Eddie's own image, people on the right, empty wall on the left for the text),
  a short pitch and a button to the quick-tees collection page, which holds
  the same-day tees and their rules. Hidden when that collection is missing
  or empty.

  @param {string} content - Required. Eyebrow, heading and line.

  @example
  {% block 'quick-tees' %}
    <h2 id="quick-title">{{ 'home.quick.title' | t }}</h2>
  {% endblock %}
{% enddoc %}

{%- assign quick = collections['quick-tees'] -%}
{%- if quick != blank and quick.products.size > 0 -%}
  <section class="quick-ban" aria-labelledby="quick-title" {{ block.shopify_attributes }}>
    <img class="quick-ban-photo" src="{{ 'quick-tees-family.jpg' | asset_url }}" alt="" width="1774" height="887" loading="lazy">
    <div class="quick-ban-text">
      {{ content }}
      <ul class="inh-facts">
        <li>{{ 'home.quick.fact_time' | t }}</li>
      </ul>
      <a class="quick-ban-cta" href="{{ quick.url }}">{{ 'home.quick.cta' | t }} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:general.quick_tees",
  "settings": []
}
{% endschema %}
