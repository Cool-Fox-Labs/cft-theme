[
  {
    "name": "theme_info",
    "theme_name": "Cool Fox Tees",
    "theme_version": "0.1.0",
    "theme_author": "Cool Fox Labs",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F2F3F0",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1D1D1B",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#EB7024",
        "label": "t:labels.accent"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 8
      }
    ]
  },
  {
    "name": "t:general.business",
    "settings": [
      {
        "type": "text",
        "id": "showroom_address",
        "label": "t:labels.showroom_address",
        "default": "Unit 12, Bath Place, Leamington Spa CV31 3AQ"
      },
      {
        "type": "text",
        "id": "showroom_hours",
        "label": "t:labels.showroom_hours",
        "default": "Monday to Friday, 9am to 4pm"
      },
      {
        "type": "text",
        "id": "phone",
        "label": "t:labels.phone",
        "default": "07706 949932"
      },
      {
        "type": "text",
        "id": "email",
        "label": "t:labels.email",
        "info": "t:info.email"
      },
      {
        "type": "text",
        "id": "google_rating",
        "label": "t:labels.google_rating",
        "default": "5.0"
      },
      {
        "type": "number",
        "id": "google_review_count",
        "label": "t:labels.google_review_count",
        "default": 29
      },
      {
        "type": "url",
        "id": "google_reviews_url",
        "label": "t:labels.google_reviews_url"
      }
    ]
  }
]
