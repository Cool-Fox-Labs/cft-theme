{% style %}
  {% comment %} Self-hosted brand fonts (SIL Open Font Licence), latin subset only. {% endcomment %}
  @font-face {
    font-family: 'Familjen Grotesk';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('{{ 'familjen-grotesk-latin.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'Hanken Grotesk';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'hanken-grotesk-latin.woff2' | asset_url }}') format('woff2');
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'ibm-plex-mono-500-latin.woff2' | asset_url }}') format('woff2');
  }

  :root {
    --font-primary--family: 'Hanken Grotesk', 'Helvetica Neue', Arial, sans-serif;
    --font-primary--style: normal;
    --font-primary--weight: 400;
    --font-display: 'Familjen Grotesk', 'Helvetica Neue', Arial, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    --page-width: {{ settings.max_page_width }};
    --page-margin: max({{ settings.min_page_margin }}px, 2.5vw);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-accent: {{ settings.accent_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
