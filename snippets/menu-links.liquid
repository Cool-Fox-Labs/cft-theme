{% doc %}
  Renders the Garments or Services link list used by both the desktop
  drop-down panels and the phone drawer, so the two menus never drift apart.

  Garment links point at collections by handle; the collections themselves
  are created later. Service links point at the homepage How it works
  section until each service has its own page. The Garments list ends with
  a Full catalogue link to the supplier catalogue site, opened in a new tab
  (its quote basket fails inside a frame, so it is not embedded).

  @param {string} list - Either 'garments' or 'services'.

  @example
  {% render 'menu-links', list: 'garments' %}
{% enddoc %}

{%- liquid
  if list == 'garments'
    assign items = 't_shirts,hoodies,sportswear,workwear,headwear,totes' | split: ','
    assign handles = 't-shirts,hoodies-and-sweatshirts,sportswear,workwear,headwear,tote-bags' | split: ','
  else
    assign items = 'one_off,hen_stag,leavers,events,uniforms' | split: ','
  endif
-%}

<div class="cats">
  {%- for item in items -%}
    {%- liquid
      if list == 'garments'
        assign url = routes.collections_url | append: '/' | append: handles[forloop.index0]
      else
        assign url = routes.root_url | append: '#how'
      endif
      assign title_key = 'menu.' | append: list | append: '.' | append: item | append: '.title'
      assign text_key = 'menu.' | append: list | append: '.' | append: item | append: '.text'
    -%}
    <a href="{{ url }}">
      <b>{{ title_key | t }}</b>
      <span>{{ text_key | t }}</span>
    </a>
  {%- endfor -%}
  {%- assign catalogue_url = settings.full_catalogue_url | strip -%}
  {%- if list == 'garments' and catalogue_url != blank -%}
    <a href="{{ catalogue_url | escape }}" target="_blank" rel="noopener">
      <b>{{ 'menu.garments.full_catalogue.title' | t }}</b>
      <span>{{ 'menu.garments.full_catalogue.text' | t }}</span>
    </a>
  {%- endif -%}
</div>
