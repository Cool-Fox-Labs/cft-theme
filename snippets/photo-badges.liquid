{% doc %}
  Up to two small badges on a product photo (Eddie, 21/11/2026), in this order:
  - The fabric weight, e.g. "180gsm", on every product with a cft.gsm value
    (Eddie, 22/11/2026: weight only, no "Heavyweight" word, which could
    mislead).
  - "Organic": cft.fabric contains "organic".
  - "Oversized fit": the title contains "oversized"; else "Boxy fit" when it
    contains "boxy" (a different cut: wide and shorter).
  Nothing is printed when no badge applies.

  @param {product} product - The product.
  @param {string} [class] - Extra class on the wrapper ('pb-card' or 'pb-page').

  @example
  {% render 'photo-badges', product: product, class: 'pb-card' %}
{% enddoc %}

{%- liquid
  assign gsm = product.metafields.cft.gsm.value | plus: 0
  assign fabric = product.metafields.cft.fabric.value | downcase
  assign title = product.title | downcase

  assign heavy = false
  if gsm > 0
    assign heavy = true
  endif

  assign organic = false
  if fabric contains 'organic'
    assign organic = true
  endif

  assign fit = ''
  if title contains 'oversized'
    assign fit = 'collections.badge_oversized'
  elsif title contains 'boxy'
    assign fit = 'collections.badge_boxy'
  endif

  assign shown = 0
-%}

{%- if heavy or organic or fit != '' -%}
  <span class="pbadges {{ class }}">
    {%- if heavy -%}<span class="pbadge pbadge-heavy">{{ 'collections.badge_gsm' | t: gsm: gsm }}</span>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- if organic -%}<span class="pbadge pbadge-organic">{{ 'collections.badge_organic' | t }}</span>{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- if fit != '' and shown < 2 -%}<span class="pbadge">{{ fit | t }}</span>{%- endif -%}
  </span>
{%- endif -%}
