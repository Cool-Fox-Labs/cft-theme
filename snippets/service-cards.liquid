{% doc %}
  Cards linking to the service pages that exist, with title and a
  short line. Pages that have not been created yet are left out.

  @param {string} skip - Handle of a page to leave out (the current one).

  @example
  {% render 'service-cards', skip: page.handle %}
{% enddoc %}

{%- capture services %}{% render 'services-data' %}{% endcapture -%}
{%- assign services = services | strip | split: ',' -%}
<div class="svc-cards">
  {%- for s in services -%}
    {%- liquid
      assign parts = s | split: ':'
      assign p = pages[parts[1]]
      if p == empty or p == nil or parts[1] == skip
        continue
      endif
      assign card_key = 'pages.service.card_' | append: parts[0]
    -%}
    <a class="svc-card" href="{{ p.url }}">
      <b>{{ p.title | escape }}</b>
      <span>{{ card_key | t }}</span>
    </a>
  {%- endfor -%}
</div>
