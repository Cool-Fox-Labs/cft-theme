{%- comment -%}
  The basket is a quote basket. Only items from products tagged buy-online
  (with a price) can go to checkout; everything else is sent as a quote
  request. Checkout takes the whole basket, so it only shows once no quote
  items are left.
{%- endcomment -%}
{%- liquid
  assign has_quote = false
  assign has_buy = false
  for item in cart.items
    if item.final_price > 0 and item.product.tags contains 'buy-online'
      assign has_buy = true
    else
      assign has_quote = true
    endif
  endfor
-%}

{% block 'container', tag: 'div' %}
  <div class="basket">
    <h1>{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="pill pill-l" href="{{ routes.collections_url }}">{{ 'cart.browse' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="basket-grid" data-basket>
        <div class="basket-main">
        <ul class="basket-items">
          {%- for item in cart.items -%}
            {%- assign buy = false -%}
            {%- if item.final_price > 0 and item.product.tags contains 'buy-online' -%}{%- assign buy = true -%}{%- endif -%}
            <li class="basket-item"{% unless buy %} data-quote-key="{{ item.key }}"{% endunless %}>
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: class: 'basket-img', alt: item.product.title, loading: 'lazy' }}
              {%- endif -%}
              <div class="basket-info">
                <a href="{{ item.url }}"><b>{{ item.product.title | escape }}</b></a>
                <span>{{ item.variant.title | escape }}</span>
                {%- if buy -%}<span>{{ item.final_line_price | money }}</span>{%- endif -%}
                <dl class="basket-props">
                  {%- for p in item.properties -%}
                    {%- assign first = p.first | slice: 0 -%}
                    {%- if p.last != blank and first != '_' -%}
                      <dt>{{ p.first | escape }}</dt>
                      <dd>
                        {%- if p.last contains '/uploads/' -%}
                          <a href="{{ p.last }}" target="_blank" rel="noopener">{{ 'cart.view_file' | t }}</a>
                        {%- else -%}
                          {{ p.last | escape }}
                        {%- endif -%}
                      </dd>
                    {%- endif -%}
                  {%- endfor -%}
                </dl>
              </div>
              <div class="basket-qty">
                <label>{{ 'cart.qty' | t }}<input type="number" name="updates[]" min="0" value="{{ item.quantity }}"></label>
                <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <a class="basket-more" href="{{ routes.collections_url }}">+ {{ 'cart.add_more' | t }}</a>
        </div>

        <div class="basket-side">
          <button type="submit" class="text-btn" name="update">{{ 'cart.update' | t }}</button>
          <label class="fz-note">{{ 'cart.note' | t }}<textarea name="note" rows="3">{{ cart.note }}</textarea></label>
          {%- if has_quote -%}
            <h2>{{ 'cart.quote_title' | t }}</h2>
            <p>{{ 'cart.quote_text' | t }}</p>
            {%- assign a = customer.default_address -%}
            <fieldset class="quote-contact" data-quote-contact>
              <legend>{{ 'cart.contact_title' | t }}</legend>
              <label>{{ 'pages.quote.f_name' | t }} *<input name="q_name" autocomplete="name" aria-required="true" value="{{ customer.name | escape }}"></label>
              <label>{{ 'pages.quote.f_email' | t }} *<input type="email" name="q_email" autocomplete="email" aria-required="true" value="{{ customer.email | escape }}"></label>
              <label>{{ 'pages.quote.f_phone' | t }} *<input type="tel" name="q_phone" autocomplete="tel" aria-required="true" value="{{ customer.phone | default: a.phone | escape }}"></label>
              <label>{{ 'cart.f_company' | t }}<input name="q_company" autocomplete="organization" value="{{ a.company | escape }}"></label>
              <p class="gq-hint">{{ 'cart.contact_hint' | t }}</p>
            </fieldset>
            <fieldset class="quote-contact quote-ship" data-quote-ship>
              <legend>{{ 'cart.ship_title' | t }}</legend>
              <label class="ship-opt"><input type="radio" name="q_ship" value="collect" checked>
                <span><b>{{ 'cart.ship_collect' | t }}</b>{%- if settings.showroom_address != blank -%}<small>{{ settings.showroom_address | escape }}</small>{%- endif -%}</span></label>
              <label class="ship-opt"><input type="radio" name="q_ship" value="deliver">
                <span><b>{{ 'cart.ship_deliver' | t }}</b><small>{{ 'cart.ship_deliver_text' | t }}</small></span></label>
              <div class="ship-addr" data-ship-addr hidden>
                <label>{{ 'cart.f_address1' | t }} *<input name="q_address1" autocomplete="address-line1" value="{{ a.address1 | escape }}"></label>
                <label>{{ 'cart.f_address2' | t }}<input name="q_address2" autocomplete="address-line2" value="{{ a.address2 | escape }}"></label>
                <label>{{ 'cart.f_city' | t }} *<input name="q_city" autocomplete="address-level2" value="{{ a.city | escape }}"></label>
                <label>{{ 'cart.f_postcode' | t }} *<input name="q_postcode" autocomplete="postal-code" value="{{ a.zip | escape }}"></label>
              </div>
            </fieldset>
            <button type="button" class="pill pill-o" data-send-quote data-endpoint="{{ settings.quote_endpoint | default: '/apps/account/quote' | escape }}"{% if pages['get-a-quote'].url %} data-sent-url="{{ pages['get-a-quote'].url }}#sent"{% endif %} data-sent-label="{{ 'cart.quote_sent' | t }}">{{ 'cart.send_quote' | t }}</button>
            <p aria-live="polite" data-quote-msg data-need="{{ 'cart.need_contact' | t }}" data-need-email="{{ 'cart.need_email' | t }}" data-need-address="{{ 'cart.need_address' | t }}" data-fail="{{ 'cart.quote_fail' | t }}" data-ok="{{ 'cart.quote_ok' | t }}"></p>
            {%- if has_buy -%}<p class="gq-hint">{{ 'cart.buy_after_quote' | t }}</p>{%- endif -%}
          {%- else -%}
            <h2>{{ 'cart.buy_title' | t }}</h2>
            <p>{{ 'cart.buy_text' | t }}</p>
            <p class="basket-total"><span>{{ 'cart.subtotal' | t }}</span><b>{{ cart.total_price | money }}</b></p>
            <button type="submit" class="pill pill-o" name="checkout">{{ 'cart.checkout' | t }}</button>
          {%- endif -%}
        </div>
      </form>
    {%- endif -%}
  </div>
{% endblock %}
