{% comment %}
  A garment category page: heading and intro, three short facts, then one
  grid of garment cards, cheapest first (lowest variant price; prices are not
  shown), Uneek first, with kids' styles (group:Kids) after the adult ones. Eddie, 21/11/2026: one grid with filters instead of sections.

  Filters: tag a product "group:Heavyweight" (any name) and a "Heavyweight"
  button appears above the grid; tapping it shows only that group. "All" shows
  everything, untagged products included. Buttons follow the collection's product
  order in the admin (the first product of each group decides). With fewer than two groups there are no buttons.
  The groups "Classic" and "Premium" still give their cards a badge.
  The last card links to the full catalogue (theme setting full_catalogue_url).

  In-house stock (Eddie, 21/11/2026): products whose tags include one of the
  style codes in the theme setting "In-house stock style codes" (default
  UC301, UC318, UC306) are shown in their own "Our classic tees" section at
  the top, without the brand name, and left out of the grid below.
{% endcomment %}

{% block 'container', tag: 'div' %}
  <div class="coll">
    <nav class="crumbs" aria-label="{{ 'product.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'product.home' | t }}</a> /
      {{ collection.title | escape }}
    </nav>

    <header class="coll-head">
      <div>
        <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="coll-intro">{{ collection.description }}</div>
        {%- else -%}
          <p class="coll-intro">{{ 'collections.intro' | t }}</p>
        {%- endif -%}
      </div>
      <ul class="coll-facts">
        <li><b>{{ 'collections.fact_discount_title' | t }}</b><span>{{ 'collections.fact_discount_text' | t }}</span></li>
        <li><b>{{ 'collections.fact_min_title' | t }}</b><span>{{ 'collections.fact_min_text' | t }}</span></li>
        <li><b>{{ 'collections.fact_showroom_title' | t }}</b><span>{{ 'collections.fact_showroom_text' | t }}</span></li>
      </ul>
    </header>

    {% paginate collection.products by 50 %}
      {%- liquid
        assign sorted = collection.products | sort: 'price'
        assign group_list = ''
        for product in collection.products
          for tag in product.tags
            assign head = tag | slice: 0, 6 | downcase
            if head == 'group:'
              assign name = tag | slice: 6, 100 | strip
              if name != blank
                assign group_list = group_list | append: name | append: '|'
              endif
            endif
          endfor
        endfor
        assign groups = group_list | split: '|' | uniq

        assign inh_codes = settings.inhouse_codes | upcase | remove: ' ' | split: ','
        assign inh_handles = '|'
        assign inh_count = 0
        if inh_codes.size > 0
          for product in sorted
            for tag in product.tags
              assign t = tag | upcase | strip
              if inh_codes contains t
                assign inh_handles = inh_handles | append: product.handle | append: '|'
                assign inh_count = inh_count | plus: 1
                break
              endif
            endfor
          endfor
        endif
        assign grid_count = collection.products_count | minus: inh_count
      -%}

      {%- if inh_count > 0 -%}
        <section class="inh" aria-labelledby="inh-title">
          <div class="inh-head">
            <div>
              <span class="eyebrow">{{ 'collections.inh_eyebrow' | t }}</span>
              <h2 id="inh-title">{{ 'collections.inh_title' | t }}</h2>
              <p>{{ 'collections.inh_text' | t }}</p>
            </div>
            <div>
            <ul class="inh-facts">
              <li>{{ 'collections.inh_fact_stock' | t }}</li>
              <li>{{ 'collections.inh_fact_fast' | t }}</li>
              <li>{{ 'collections.inh_fact_sameday' | t }}</li>
            </ul>
            {%- assign inh_contact_page = pages['contact'] -%}
            {%- if inh_contact_page != empty and inh_contact_page != nil -%}
              <a class="inh-contact" href="{{ inh_contact_page.url }}">{{ 'collections.inh_contact' | t }} <span aria-hidden="true">&rarr;</span></a>
            {%- endif -%}
            </div>
          </div>
          <div class="coll-grid inh-grid">
            {%- assign inh_meta = 'collections.inh_card_meta' | t -%}
            {%- comment -%} Adult styles first, then kids (group:Kids), cheapest first within each. {%- endcomment -%}
            {%- for pass in (1..2) -%}
              {%- for product in sorted -%}
                {%- assign key = '|' | append: product.handle | append: '|' -%}
                {%- unless inh_handles contains key -%}{%- continue -%}{%- endunless -%}
                {%- assign is_kids = false -%}
                {%- for tag in product.tags -%}{%- assign tl = tag | downcase | remove: ' ' -%}{%- if tl == 'group:kids' -%}{%- assign is_kids = true -%}{%- endif -%}{%- endfor -%}
                {%- if is_kids and pass == 1 -%}{%- continue -%}{%- endif -%}
                {%- unless is_kids or pass == 1 -%}{%- continue -%}{%- endunless -%}
                {% render 'garment-card', product: product, meta: inh_meta %}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </section>
        <h2 class="coll-more">{{ 'collections.more' | t }}</h2>
      {%- endif -%}

      <div class="coll-bar" data-coll-filter>
        <p class="coll-count" data-count-one="{{ 'collections.count_one' | t }}" data-count="{{ 'collections.count' | t: n: '%n' }}">
          {%- if grid_count == 1 -%}{{ 'collections.count_one' | t }}{%- else -%}{{ 'collections.count' | t: n: grid_count }}{%- endif -%}
        </p>
        {%- if groups.size > 1 -%}
          <div class="coll-filter" role="group" aria-label="{{ 'collections.filter' | t }}">
            <button type="button" aria-pressed="true" data-filter="">{{ 'collections.filter_all' | t }}</button>
            {%- for g in groups -%}
              <button type="button" aria-pressed="false" data-filter="{{ g | handleize }}">{{ g | escape }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if collection.products.size == 0 -%}
        <div class="coll-empty">
          <p>{{ 'collections.empty' | t }}</p>
          <a class="pill pill-o" href="{{ routes.root_url }}#garments">{{ 'collections.empty_cta' | t }}</a>
        </div>
      {%- else -%}
        <div class="coll-grid">
          {%- comment -%}
            Order (Eddie, 21/11/2026): adult Uneek styles first (the in-stock range),
            then other adult styles, then kids' styles (group:Kids) the same way.
            Cheapest first within each.
          {%- endcomment -%}
          {%- for pass in (1..4) -%}
            {%- for product in sorted -%}
              {%- assign key = '|' | append: product.handle | append: '|' -%}
              {%- if inh_handles contains key -%}{%- continue -%}{%- endif -%}
              {%- assign mine = '' -%}
              {%- for tag in product.tags -%}
                {%- assign head = tag | slice: 0, 6 | downcase -%}
                {%- if head == 'group:' -%}
                  {%- assign gname = tag | slice: 6, 100 | strip | handleize -%}
                  {%- assign mine = mine | append: ' ' | append: gname -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign mine = mine | strip -%}
              {%- assign kids = false -%}
              {%- assign mine_list = mine | split: ' ' -%}
              {%- if mine_list contains 'kids' -%}{%- assign kids = true -%}{%- endif -%}
              {%- assign vendor = product.vendor | downcase | strip -%}
              {%- if kids -%}{%- assign want = 3 -%}{%- else -%}{%- assign want = 1 -%}{%- endif -%}
              {%- unless vendor == 'uneek' -%}{%- assign want = want | plus: 1 -%}{%- endunless -%}
              {%- if pass != want -%}{%- continue -%}{%- endif -%}
              <div class="coll-item" data-groups="{{ mine }}">{% render 'garment-card', product: product %}</div>
            {%- endfor -%}
          {%- endfor -%}
          {%- comment -%} Last card: the supplier's full catalogue (theme setting). Shown whatever filter is on. {%- endcomment -%}
          {%- assign cat_url = settings.full_catalogue_url | strip -%}
          {%- if cat_url != blank -%}
            <a class="gcard gcard-cat" href="{{ cat_url | escape }}" target="_blank" rel="noopener">
              <span class="gcard-cat-in">
                <span class="gcard-cat-num">{{ 'collections.cat_card_big' | t }}</span>
                <b>{{ 'collections.cat_card_title' | t }}</b>
                <span>{{ 'collections.cat_card_text' | t }}</span>
                <span class="pill pill-o">{{ 'collections.help_cta_catalogue' | t }} &#8599;</span>
              </span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="coll-pages" aria-label="{{ 'collections.pages' | t }}">
          {%- if paginate.previous -%}<a class="pill pill-l" href="{{ paginate.previous.url }}">&larr; {{ 'collections.previous' | t }}</a>{%- endif -%}
          <span>{{ 'collections.page_of' | t: page: paginate.current_page, pages: paginate.pages }}</span>
          {%- if paginate.next -%}<a class="pill pill-l" href="{{ paginate.next.url }}">{{ 'collections.next' | t }} &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {% endpaginate %}

    {%- comment -%} Backup only: the last grid card already links to the full catalogue (Eddie, 21/11/2026: not both). This box shows only when the catalogue setting is blank. {%- endcomment -%}
    {%- assign catalogue_url = settings.full_catalogue_url | strip -%}
    {%- if catalogue_url == blank -%}
      {%- assign quote_page = pages['get-a-quote'] -%}
      <aside class="coll-help">
        <div>
          <b>{{ 'collections.help_title' | t }}</b>
          <span>{{ 'collections.help_text' | t }}</span>
        </div>
        <a class="pill pill-o" href="{% if quote_page.url %}{{ quote_page.url }}{% else %}{{ routes.root_url }}#how{% endif %}">{{ 'collections.help_cta' | t }}</a>
      </aside>
    {%- endif -%}
  </div>
{% endblock %}
