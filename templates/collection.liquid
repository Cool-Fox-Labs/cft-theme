{% comment %}
  A garment category page: heading and intro, three short facts, then a grid
  of garment cards. The intro is the collection's own description in the
  admin; without one, a general line is used.

  Sections: tag a product "group:Heavyweight" (any name) and the page splits
  into headed sections, A to Z, with jump buttons at the top. Untagged
  products go under "More styles" at the end. With no group tags at all the
  page is one grid. The groups "Classic" (in-house stock) and "Premium"
  (5-7 working days) also get a lead-time line, and their cards a badge.
{% endcomment %}

{% block 'container', tag: 'div' %}
  <div class="coll">
    <nav class="crumbs" aria-label="{{ 'product.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'product.home' | t }}</a> /
      {{ collection.title | escape }}
    </nav>

    <header class="coll-head">
      <div>
        <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="coll-intro">{{ collection.description }}</div>
        {%- else -%}
          <p class="coll-intro">{{ 'collections.intro' | t }}</p>
        {%- endif -%}
      </div>
      <ul class="coll-facts">
        <li><b>{{ 'collections.fact_discount_title' | t }}</b><span>{{ 'collections.fact_discount_text' | t }}</span></li>
        <li><b>{{ 'collections.fact_min_title' | t }}</b><span>{{ 'collections.fact_min_text' | t }}</span></li>
        <li><b>{{ 'collections.fact_showroom_title' | t }}</b><span>{{ 'collections.fact_showroom_text' | t }}</span></li>
      </ul>
    </header>

    {% paginate collection.products by 50 %}
      {%- liquid
        assign group_list = ''
        for product in collection.products
          for tag in product.tags
            assign head = tag | slice: 0, 6 | downcase
            if head == 'group:'
              assign name = tag | slice: 6, 100 | strip
              if name != blank
                assign group_list = group_list | append: name | append: '|'
              endif
            endif
          endfor
        endfor
        assign groups = group_list | split: '|' | uniq | sort_natural
      -%}

      <div class="coll-bar">
        <p class="coll-count">
          {%- if collection.products_count == 1 -%}{{ 'collections.count_one' | t }}{%- else -%}{{ 'collections.count' | t: n: collection.products_count }}{%- endif -%}
        </p>
        {%- if groups.size > 0 -%}
          <nav class="coll-jump" aria-label="{{ 'collections.jump' | t }}">
            {%- for g in groups -%}
              <a href="#g-{{ g | handleize }}">{{ g | escape }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>

      {%- if collection.products.size == 0 -%}
        <div class="coll-empty">
          <p>{{ 'collections.empty' | t }}</p>
          <a class="pill pill-o" href="{{ routes.root_url }}#garments">{{ 'collections.empty_cta' | t }}</a>
        </div>
      {%- elsif groups.size == 0 -%}
        <div class="coll-grid">
          {%- for product in collection.products -%}
            {% render 'garment-card', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- for g in groups -%}
          {%- assign want = 'group:' | append: g | downcase -%}
          <section class="coll-group" id="g-{{ g | handleize }}">
            <div class="coll-group-head">
              <h2>{{ g | escape }}</h2>
              {%- assign gh = g | handleize -%}
              {%- case gh -%}
                {%- when 'classic' -%}<p class="range-note range-in">{{ 'collections.range_classic' | t }}</p>
                {%- when 'premium' -%}<p class="range-note">{{ 'collections.range_premium' | t }}</p>
              {%- endcase -%}
            </div>
            <div class="coll-grid">
              {%- for product in collection.products -%}
                {%- assign hit = false -%}
                {%- for tag in product.tags -%}
                  {%- assign t = tag | downcase | replace: 'group: ', 'group:' -%}
                  {%- if t == want -%}{%- assign hit = true -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
                {%- if hit -%}{% render 'garment-card', product: product %}{%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endfor -%}

        {%- capture rest -%}
          {%- for product in collection.products -%}
            {%- assign in_group = false -%}
            {%- for tag in product.tags -%}
              {%- assign head = tag | slice: 0, 6 | downcase -%}
              {%- if head == 'group:' -%}{%- assign in_group = true -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- unless in_group -%}{% render 'garment-card', product: product %}{%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if rest != blank -%}
          <section class="coll-group" id="g-more">
            <div class="coll-group-head"><h2>{{ 'collections.more' | t }}</h2></div>
            <div class="coll-grid">{{ rest }}</div>
          </section>
        {%- endif -%}
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="coll-pages" aria-label="{{ 'collections.pages' | t }}">
          {%- if paginate.previous -%}<a class="pill pill-l" href="{{ paginate.previous.url }}">&larr; {{ 'collections.previous' | t }}</a>{%- endif -%}
          <span>{{ 'collections.page_of' | t: page: paginate.current_page, pages: paginate.pages }}</span>
          {%- if paginate.next -%}<a class="pill pill-l" href="{{ paginate.next.url }}">{{ 'collections.next' | t }} &rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {% endpaginate %}

    <aside class="coll-help">
      <div>
        <b>{{ 'collections.help_title' | t }}</b>
        <span>{{ 'collections.help_text' | t }}</span>
      </div>
      {%- assign quote_page = pages['get-a-quote'] -%}
      <a class="pill pill-o" href="{% if quote_page.url %}{{ quote_page.url }}{% else %}{{ routes.root_url }}#how{% endif %}">{{ 'collections.help_cta' | t }}</a>
    </aside>
  </div>
{% endblock %}
