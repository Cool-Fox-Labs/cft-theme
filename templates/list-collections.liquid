{% comment %}
  All categories. Each tile uses the collection's own image when one is set
  in the admin, otherwise the first garment's main image.
{% endcomment %}

{% block 'container', tag: 'div' %}
  <div class="coll">
    <header class="coll-head coll-head-solo">
      <div>
        <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
        <h1>{{ 'collections.title' | t }}</h1>
        <p class="coll-intro">{{ 'collections.all_intro' | t }}</p>
      </div>
    </header>

    <div class="coll-grid coll-grid-cats">
      {%- for collection in collections -%}
        {%- if collection.products_count == 0 or collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign photo = collection.image
          if photo == null
            assign photo = collection.products.first.featured_image
          endif
        -%}
        <a class="gcard" href="{{ collection.url }}">
          <div class="gcard-img">
            {%- if photo -%}
              {{ photo | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 1100px) 22vw, (min-width: 760px) 30vw, 46vw', alt: collection.title, loading: 'lazy' }}
            {%- else -%}
              <img src="{{ 'logo-fox-head.svg' | asset_url }}" width="500" height="600" alt="" loading="lazy" class="gcard-ph">
            {%- endif -%}
          </div>
          <div class="gcard-body">
            <b>{{ collection.title | escape }}</b>
            <span class="gcard-meta">
              {%- if collection.products_count == 1 -%}{{ 'collections.count_one' | t }}{%- else -%}{{ 'collections.count' | t: n: collection.products_count }}{%- endif -%}
            </span>
          </div>
          <i class="gcard-go" aria-hidden="true">&rarr;</i>
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%} The way into the "tell us what you need" form (Get a quote page), plus the supplier's full catalogue when the theme setting is filled in. {%- endcomment -%}
    {%- assign quote_page = pages['get-a-quote'] -%}
    {%- assign catalogue_url = settings.full_catalogue_url | strip -%}
    {%- if quote_page.url or catalogue_url != blank -%}
      <aside class="coll-help">
        <div>
          <b>{{ 'collections.help_title_all' | t }}</b>
          <span>{{ 'collections.help_text_all' | t }}</span>
        </div>
        <div class="coll-help-cta">
          {%- if catalogue_url != blank -%}
            <a class="pill pill-l" href="{{ catalogue_url | escape }}" target="_blank" rel="noopener">{{ 'collections.help_cta_catalogue' | t }} &#8599;</a>
          {%- endif -%}
          {%- if quote_page.url -%}
            <a class="pill pill-o" href="{{ quote_page.url }}">{{ 'collections.help_cta_tell' | t }}</a>
          {%- endif -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
{% endblock %}
