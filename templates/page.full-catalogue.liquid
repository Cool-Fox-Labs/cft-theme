{% comment %}
  Full catalogue page: shows the PenCarrie unbranded catalogue site inside
  the shop, with our header and footer around it. The shop itself stays
  hand-picked; this is the browse-everything extra.

  The address comes from Theme settings > Cool Fox Tees > Full catalogue
  address. To use it: create a page in Shopify admin (handle
  "full-catalogue") and choose the "full-catalogue" template. The Garments
  menu shows a link to it once the page exists.

  A cross-site frame cannot size itself to its content, so it gets a fixed
  height and scrolls inside. Safari can block the catalogue's quote basket
  inside a frame, so the "open in a new tab" link is always shown.
{% endcomment %}

{% block 'container', tag: 'section' %}
  {%- assign catalogue_url = settings.full_catalogue_url | strip -%}

  <div class="cat-page in">
    <header class="cat-head">
      <div>
        <span class="eyebrow">{{ 'pages.catalogue.eyebrow' | t }}</span>
        <h1>{{ 'pages.catalogue.title' | t }}</h1>
        <p>{{ 'pages.catalogue.intro' | t }}</p>
      </div>
      {%- if catalogue_url != blank -%}
        <a class="pill pill-l" href="{{ catalogue_url | escape }}" target="_blank" rel="noopener">
          {{- 'pages.catalogue.new_tab' | t -}}
        </a>
      {%- endif -%}
    </header>

    {%- if catalogue_url != blank -%}
      <iframe
        class="cat-frame"
        src="{{ catalogue_url | escape }}"
        title="{{ 'pages.catalogue.frame_title' | t | escape }}"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    {%- else -%}
      <p class="info-note">{{ 'pages.catalogue.missing' | t }}</p>
    {%- endif -%}

    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
{% endblock %}
