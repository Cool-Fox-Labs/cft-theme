{% comment %}
  Get a quote page. Two ways in: choose a garment (category links), or a
  short "tell us what you need" form with artwork upload. The form posts to
  the quote request address (theme setting, default /apps/account/quote, the
  Print Studio app proxy), which files it in Print Studio as "Quote requested".
  To use it: create a page in Shopify admin (handle "get-a-quote") and choose
  the "get-a-quote" template. Every "Get a quote" button then links here.
  Wording lives in locales/en.default.json under pages.quote.
  After a request is sent (from this form or from the basket) the page opens
  as /pages/get-a-quote#sent and shows the "Quote request sent" view instead,
  with a summary the sending page saved in sessionStorage (cft-quote-sent).
{% endcomment %}

{% block 'container', tag: 'section' %}
  {%- assign endpoint = settings.quote_endpoint | default: '/apps/account/quote' -%}
  <div class="gq-sent" data-quote-sent hidden>
    <span class="gq-tick" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <h1 tabindex="-1" data-sent-title data-named="{{ 'pages.quote.sent_title_named' | t: name: '%n' }}">{{ 'pages.quote.sent_title' | t }}</h1>
    <p class="gq-sent-lead">{{ 'pages.quote.sent_lead' | t }}</p>
    <div class="gq-sum" data-sent-summary hidden>
      <h2>{{ 'pages.quote.sent_summary' | t }}</h2>
      <dl data-sent-list></dl>
      <script type="application/json" data-sent-labels>
        {"contact": {{ 'pages.quote.sum_contact' | t | json }}, "items": {{ 'pages.quote.sum_items' | t | json }}, "garment": {{ 'pages.quote.sum_garment' | t | json }}, "quantity": {{ 'pages.quote.sum_qty' | t | json }}, "neededBy": {{ 'pages.quote.sum_date' | t | json }}, "files": {{ 'pages.quote.sum_files' | t | json }}}
      </script>
    </div>
    <div class="gq-next">
      <h2>{{ 'pages.quote.next_title' | t }}</h2>
      <ol>
        <li><b>{{ 'pages.quote.next_1_title' | t }}</b>{{ 'pages.quote.next_1' | t }}</li>
        <li><b>{{ 'pages.quote.next_2_title' | t }}</b>{{ 'pages.quote.next_2' | t }}</li>
        <li><b>{{ 'pages.quote.next_3_title' | t }}</b>{{ 'pages.quote.next_3' | t }}</li>
      </ol>
    </div>
    <p class="gq-sent-help">{{ 'pages.quote.sent_help' | t }}</p>
    <div class="gq-sent-cta">
      <a class="pill pill-o" href="{{ routes.collections_url }}">{{ 'pages.quote.sent_browse' | t }}</a>
      <a class="pill pill-l" href="{{ routes.root_url }}">{{ 'pages.quote.sent_home' | t }}</a>
    </div>
  </div>

  <div class="gq" data-quote-start>
    <header class="info-head">
      <span class="eyebrow">{{ 'pages.quote.eyebrow' | t }}</span>
      <h1>{{ 'pages.quote.title' | t }}</h1>
      <p>{{ 'pages.quote.intro' | t }}</p>
    </header>

    <div class="gq-grid">
      <section class="gq-card">
        <span class="gq-num">1</span>
        <h2>{{ 'pages.quote.pick_title' | t }}</h2>
        <p>{{ 'pages.quote.pick_text' | t }}</p>
        {% render 'menu-links', list: 'garments' %}
      </section>

      <section class="gq-card gq-form-card">
        <span class="gq-num">2</span>
        <h2>{{ 'pages.quote.form_title' | t }}</h2>
        <p>{{ 'pages.quote.form_text' | t }}</p>
        <form class="gq-form" data-quote-form action="{{ endpoint | escape }}" method="post" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="source" value="form">
          <label class="gq-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
          <label>{{ 'pages.quote.f_garment' | t }} *<textarea name="garment" rows="3" placeholder="{{ 'pages.quote.f_garment_ph' | t }}"></textarea></label>
          <fieldset class="gq-seg">
            <legend>{{ 'pages.quote.f_budget' | t }}</legend>
            {%- assign budgets = 'pages.quote.budget_options' | t | split: '|' -%}
            {%- for b in budgets -%}
              <label><input type="radio" name="budget" value="{{ b | escape }}"><span>{{ b | escape }}</span></label>
            {%- endfor -%}
          </fieldset>
          <div class="gq-two">
            <label>{{ 'pages.quote.f_qty' | t }}<input type="number" name="quantity" min="1" inputmode="numeric"></label>
            <label>{{ 'pages.quote.f_date' | t }}<input type="date" name="needed_by"></label>
          </div>
          <label>{{ 'pages.quote.f_files' | t }}<input type="file" name="files[]" multiple accept="image/*,.pdf,.ai,.eps,.svg,.psd"></label>
          <p class="gq-hint">{{ 'pages.quote.f_files_hint' | t }}</p>
          <label>{{ 'pages.quote.f_notes' | t }}<textarea name="notes" rows="3" placeholder="{{ 'pages.quote.f_notes_ph' | t }}"></textarea></label>

          {%- assign a = customer.default_address -%}
          <fieldset class="quote-contact">
            <legend>{{ 'cart.contact_title' | t }}</legend>
            <label>{{ 'pages.quote.f_name' | t }} *<input name="name" autocomplete="name" value="{{ customer.name | escape }}"></label>
            <div class="gq-two">
              <label>{{ 'pages.quote.f_email' | t }} *<input type="email" name="email" autocomplete="email" value="{{ customer.email | escape }}"></label>
              <label>{{ 'pages.quote.f_phone' | t }} *<input type="tel" name="phone" autocomplete="tel" value="{{ customer.phone | default: a.phone | escape }}"></label>
            </div>
            <label>{{ 'cart.f_company' | t }}<input name="company" autocomplete="organization" value="{{ a.company | escape }}"></label>
          </fieldset>
          <fieldset class="quote-contact quote-ship" data-quote-ship>
            <legend>{{ 'cart.ship_title' | t }}</legend>
            <label class="ship-opt"><input type="radio" name="ship" value="collect" checked>
              <span><b>{{ 'cart.ship_collect' | t }}</b>{%- if settings.showroom_address != blank -%}<small>{{ settings.showroom_address | escape }}</small>{%- endif -%}</span></label>
            <label class="ship-opt"><input type="radio" name="ship" value="deliver">
              <span><b>{{ 'cart.ship_deliver' | t }}</b><small>{{ 'cart.ship_deliver_text' | t }}</small></span></label>
            <div class="ship-addr" data-ship-addr hidden>
              <label>{{ 'cart.f_address1' | t }} *<input name="address1" autocomplete="address-line1" value="{{ a.address1 | escape }}"></label>
              <label>{{ 'cart.f_address2' | t }}<input name="address2" autocomplete="address-line2" value="{{ a.address2 | escape }}"></label>
              <label>{{ 'cart.f_city' | t }} *<input name="city" autocomplete="address-level2" value="{{ a.city | escape }}"></label>
              <label>{{ 'cart.f_postcode' | t }} *<input name="zip" autocomplete="postal-code" value="{{ a.zip | escape }}"></label>
            </div>
          </fieldset>
          <button type="submit" class="pill pill-o">{{ 'pages.quote.send' | t }}</button>
          <p class="gq-msg" aria-live="polite" data-quote-form-msg
            data-need="{{ 'pages.quote.need_contact' | t }}"
            data-need-garment="{{ 'pages.quote.need_garment' | t }}"
            data-need-email="{{ 'cart.need_email' | t }}"
            data-need-address="{{ 'cart.need_address' | t }}"
            data-l-budget="{{ 'pages.quote.note_budget' | t }}"
            data-l-company="{{ 'pages.quote.note_company' | t }}"
            data-l-collect="{{ 'pages.quote.note_collect' | t }}"
            data-l-deliver="{{ 'pages.quote.note_deliver' | t }}"
            data-big="{{ 'pages.quote.too_big' | t }}"
            data-sending="{{ 'pages.quote.sending' | t }}"
            data-ok="{{ 'pages.quote.ok' | t }}"
            data-fail="{{ 'pages.quote.fail' | t }}"></p>
        </form>
      </section>
    </div>
  </div>
{% endblock %}
