{% comment %}
  One service page (Eddie, 19/11/2026). Choose the "service" template on a
  page. The wording is the page's own content, edited in Shopify admin; the
  photo is the theme asset service-{page handle}.jpg. Below the text: the
  key facts, a quote button and links to the other services.
{% endcomment %}

{% block 'container', tag: 'section' %}
  {%- liquid
    assign photo = 'service-' | append: page.handle | append: '.jpg'
    assign quote_page = pages['get-a-quote']
    assign services_page = pages['services']
    assign facts = 'minimum,discount,proof,time,showroom' | split: ','
  -%}

  <div class="svc in">
    <header class="svc-head">
      <div class="svc-txt">
        <span class="eyebrow">
          {%- if services_page -%}<a href="{{ services_page.url }}">{{ 'pages.service.eyebrow' | t }}</a>{%- else -%}{{ 'pages.service.eyebrow' | t }}{%- endif -%}
        </span>
        <h1>{{ page.title | escape }}</h1>
        <div class="svc-btns">
          <a class="pill pill-o" href="{{ routes.collections_url }}">{{ 'pages.service.build' | t }}</a>
          {%- if quote_page -%}<a class="pill pill-l" href="{{ quote_page.url }}">{{ 'pages.service.tell_us' | t }}</a>{%- endif -%}
        </div>
      </div>
      <img class="svc-img" src="{{ photo | asset_url }}" width="1600" height="1200" alt="" fetchpriority="high">
    </header>

    <div class="svc-body">
      <div class="rte svc-rte">{{ page.content }}</div>
      <aside class="svc-facts" aria-labelledby="svc-facts-h">
        <h2 id="svc-facts-h">{{ 'pages.service.facts_title' | t }}</h2>
        <ul>
          {%- for f in facts -%}
            {%- assign fact_key = 'pages.service.fact_' | append: f -%}
            <li>{{ fact_key | t }}</li>
          {%- endfor -%}
        </ul>
        <a class="pill pill-o" href="{{ routes.collections_url }}">{{ 'pages.service.build' | t }}</a>
      </aside>
    </div>

    <section class="svc-more" aria-labelledby="svc-more-h">
      <h2 id="svc-more-h">{{ 'pages.service.more_title' | t }}</h2>
      {% render 'service-cards', skip: page.handle %}
    </section>
  </div>
{% endblock %}
